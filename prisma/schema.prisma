// ============================================================================
// CONFIGURACIÓN DE PRISMA v7 (PostgreSQL)
// ============================================================================
// =================================================
/**
 * NO CAMBIAR NADA
 */
// =================================================
generator client {
  /// Nuevo generador TypeScript nativo de Prisma v7 (sin binarios Rust)
  provider = "prisma-client-js"
}

datasource db {
  /// En Prisma v7 la URL de conexión se define en prisma.config.ts, no aquí
  provider = "postgresql"
}

// ============================================================================
// 1. MÓDULO DE SEGURIDAD Y USUARIOS
// ============================================================================

/// Roles del sistema (ej. Administrador, Vendedor, Bodeguero, Cliente)
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(60)
  description String @db.VarChar(255)

  users          User[]
  rolePrivileges RolePrivilege[]

  @@map("roles")
}

/// Módulos funcionales del sistema (ej. 'Users', 'Sales', 'Products', 'CashRegisters')
model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(80)

  privileges Privilege[]

  @@map("permissions")
}

/// Acciones permitidas dentro de cada módulo (ej. 'Create', 'Read', 'Update', 'Delete', 'Approve')
model Privilege {
  id           Int    @id @default(autoincrement())
  permissionId Int    @map("permission_id")
  name         String @db.VarChar(50)

  permission     Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  rolePrivileges RolePrivilege[]

  @@unique([permissionId, name], map: "idx_unique_permission_action")
  @@map("privileges")
}

/// Tabla pivote que asigna privilegios específicos a cada rol
model RolePrivilege {
  id          Int @id @default(autoincrement())
  roleId      Int @map("role_id")
  privilegeId Int @map("privilege_id")

  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  privilege Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@unique([roleId, privilegeId])
  @@map("role_privileges")
}

/// Catálogo de tipos de documento de identidad (ej. CC, NIT, CE, Pasaporte)
model DocumentType {
  id           Int    @id @default(autoincrement())
  documentType String @map("document_type") @db.VarChar(20)

  users     User[]
  suppliers Supplier[]

  @@map("document_types")
}

/// Usuarios del sistema: empleados internos y clientes registrados
model User {
  identityDocument String   @id @map("identity_document") @db.VarChar(20)
  documentTypeId   Int      @map("document_type_id")
  firstName        String   @map("first_name") @db.VarChar(120)
  lastName         String   @map("last_name") @db.VarChar(120)
  email            String   @unique @db.VarChar(150)
  phone            String   @db.VarChar(20)
  address          String?  @db.VarChar(255)
  password         String?  @db.VarChar(200)
  roleId           Int?     @map("role_id")
  status           String   @default("Active") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  documentType    DocumentType @relation(fields: [documentTypeId], references: [id])
  role            Role?        @relation(fields: [roleId], references: [id])
  salesAsCustomer Sale[]       @relation("CustomerSales")
  salesAsSeller   Sale[]       @relation("SellerSales")
  payments        Payment[]
  saleReturns     SaleReturn[]
  expenses        Expense[]

  @@map("users")
}

// ============================================================================
// 2. MÓDULO DE INVENTARIO Y PRODUCTOS
// ============================================================================

/// Categorías principales de calzado (ej. Deportivo, Casual, Formal)
model ProductCategory {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(80)
  description String @db.VarChar(255)

  products Product[]

  @@map("product_categories")
}

/// Marcas comerciales de calzado
model Brand {
  id     Int    @id @default(autoincrement())
  name   String @unique @db.VarChar(80)
  status String @default("Active") @db.VarChar(20)

  products Product[]

  @@map("brands")
}

/// Estilos o tipos específicos de zapato (ej. Tenis, Bota, Sandalia, Mocasín)
model ShoeType {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  products Product[]

  @@map("shoe_types")
}

/// Producto base (modelo de zapato) antes de desglosar por color y talla
model Product {
  id                Int     @id @default(autoincrement())
  sku               String? @unique @db.VarChar(50)
  name              String  @db.VarChar(120)
  productCategoryId Int     @map("product_category_id")
  brandId           Int     @map("brand_id")
  shoeTypeId        Int     @map("shoe_type_id")
  purchasePrice     Decimal @map("purchase_price") @db.Decimal(12, 2)
  salePrice         Decimal @map("sale_price") @db.Decimal(12, 2)
  isPublic          Boolean @default(true) @map("is_public")
  gender            String  @db.VarChar(10)
  status            String  @default("Active") @db.VarChar(20)

  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id])
  brand           Brand           @relation(fields: [brandId], references: [id])
  shoeType        ShoeType        @relation(fields: [shoeTypeId], references: [id])
  productColors   ProductColor[]

  @@map("products")
}

/// Paleta maestra de colores con su código hexadecimal
model Color {
  id   Int    @id @default(autoincrement())
  name String @map("color") @db.VarChar(50)
  hex  String @db.VarChar(50)

  productColors ProductColor[]

  @@map("colors")
}

/// Combinación de un producto con un color específico y su imagen principal
model ProductColor {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  colorId   Int     @map("color_id")
  image     String? @db.VarChar(255)
  status    String  @default("Active") @db.VarChar(20)

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  color           Color            @relation(fields: [colorId], references: [id])
  colorImages     ColorImage[]
  productVariants ProductVariant[]

  @@unique([productId, colorId])
  @@map("product_colors")
}

/// Galería de imágenes adicionales por cada combinación producto-color
model ColorImage {
  id             Int     @id @default(autoincrement())
  productColorId Int     @map("product_color_id")
  image          String? @db.VarChar(255)

  productColor ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  @@map("color_images")
}

/// Catálogo de tallas locales e internacionales por género
model Size {
  id                Int    @id @default(autoincrement())
  sizeNumber        String @map("size_number") @db.VarChar(10)
  gender            String @db.VarChar(10)
  internationalSize String @map("international_size") @db.VarChar(10)

  productVariants ProductVariant[]

  @@map("sizes")
}

/// Unidad mínima inventariable (SKU físico): Producto + Color + Talla con stock real
model ProductVariant {
  id             Int      @id @default(autoincrement())
  productColorId Int      @map("product_color_id")
  sizeId         Int      @map("size_id")
  currentStock   Int      @default(0) @map("current_stock")
  discount       Decimal? @default(0.00) @db.Decimal(5, 2)
  status         String   @default("Active") @db.VarChar(20)

  productColor    ProductColor     @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  size            Size             @relation(fields: [sizeId], references: [id])
  purchaseDetails PurchaseDetail[]
  saleDetails     SaleDetail[]
  saleReturns     SaleReturn[]

  @@unique([productColorId, sizeId])
  @@map("product_variants")
}

// ============================================================================
// 3. MÓDULO DE PROVEEDORES Y COMPRAS
// ============================================================================

/// Clasificación de proveedores (ej. Mayorista Nacional, Importador Directo, Fabricante)
model SupplierCategory {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(80)
  description String @db.VarChar(255)

  suppliers SupplierCategoryAssignment[]

  @@map("supplier_categories")
}

/// Proveedores de mercancía nacionales o internacionales
model Supplier {
  document       String  @id @db.VarChar(20)
  documentTypeId Int     @map("document_type_id")
  supplierType   String  @map("supplier_type") @db.VarChar(30)
  businessName   String  @map("business_name") @db.VarChar(150)
  isImported     Boolean @map("is_imported")
  phone          String  @db.VarChar(20)
  email          String  @db.VarChar(150)
  address        String? @db.VarChar(255)
  status         String  @default("Active") @db.VarChar(20)

  documentType DocumentType                 @relation(fields: [documentTypeId], references: [id])
  categories   SupplierCategoryAssignment[]
  purchases    Purchase[]

  @@map("suppliers")
}

/// Relación muchos a muchos entre proveedores y sus categorías
model SupplierCategoryAssignment {
  supplierCategoryId Int    @map("supplier_category_id")
  supplierId         String @map("supplier_id") @db.VarChar(20)

  supplierCategory SupplierCategory @relation(fields: [supplierCategoryId], references: [id], onDelete: Cascade)
  supplier         Supplier         @relation(fields: [supplierId], references: [document], onDelete: Cascade)

  @@id([supplierCategoryId, supplierId])
  @@map("suppliers_categories")
}

/// Encabezado de órdenes de compra a proveedores (ID en formato UUID)
model Purchase {
  id             String    @id @default(uuid()) @db.Uuid
  cashRegisterId Int       @map("cash_register_id")
  supplierId     String    @map("supplier_id") @db.VarChar(20)
  orderDate      DateTime  @default(now()) @map("order_date")
  status         String    @default("Pending") @db.VarChar(20)
  deliveryDate   DateTime? @map("delivery_date")
  vat            Decimal   @default(0.00) @db.Decimal(5, 2)

  cashRegister    CashRegister     @relation(fields: [cashRegisterId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [document])
  purchaseDetails PurchaseDetail[]

  @@map("purchases")
}

/// Líneas de detalle de productos adquiridos en cada orden de compra
model PurchaseDetail {
  id         Int     @id @default(autoincrement())
  purchaseId String  @map("purchase_id") @db.Uuid
  variantId  Int     @map("variant_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_details")
}

// ============================================================================
// 4. MÓDULO DE VENTAS Y PEDIDOS
// ============================================================================

/// Encabezado de ventas y pedidos de clientes (ID en formato UUID)
model Sale {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.VarChar(20)
  userId       String   @map("user_id") @db.VarChar(20)
  saleDate     DateTime @default(now()) @map("sale_date")
  discount     Decimal  @default(0.00) @db.Decimal(5, 2)
  isCredit     Boolean  @map("is_credit")
  isDirectSale Boolean? @map("is_direct_sale")
  vat          Decimal  @default(0.00) @db.Decimal(5, 2)
  status       String   @default("Completed") @db.VarChar(20)

  customer    User         @relation("CustomerSales", fields: [customerId], references: [identityDocument])
  seller      User         @relation("SellerSales", fields: [userId], references: [identityDocument])
  saleDetails SaleDetail[]
  payments    Payment[]
  saleReturns SaleReturn[]

  @@map("sales")
}

/// Líneas de detalle de variantes vendidas en cada transacción
model SaleDetail {
  id        Int     @id @default(autoincrement())
  saleId    String  @map("sale_id") @db.Uuid
  variantId Int     @map("variant_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_details")
}

/// Medios de pago aceptados (ej. Efectivo, Transferencia, Nequi, Wompi, Tarjeta)
model PaymentMethod {
  id     Int    @id @default(autoincrement())
  method String @db.VarChar(20)

  payments Payment[]

  @@map("payment_methods")
}

/// Abonos y pagos recibidos asociados a una venta (contado o crédito)
model Payment {
  id              Int      @id @default(autoincrement())
  saleId          String   @map("sale_id") @db.Uuid
  cashRegisterId  Int      @map("cash_register_id")
  userId          String   @map("user_id") @db.VarChar(20)
  paymentMethodId Int      @map("payment_method_id")
  amount          Decimal  @db.Decimal(14, 2)
  receipt         String?  @db.VarChar(255)
  paymentDate     DateTime @default(now()) @map("payment_date")
  notes           String?  @db.VarChar(255)

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashRegister  CashRegister  @relation(fields: [cashRegisterId], references: [id])
  user          User          @relation(fields: [userId], references: [identityDocument])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("payments")
}

/// Solicitudes y resoluciones de devolución de mercancía vendida (ID en formato UUID)
model SaleReturn {
  id              String    @id @default(uuid()) @db.Uuid
  saleId          String    @map("sale_id") @db.Uuid
  variantId       Int       @map("variant_id")
  userId          String    @map("user_id") @db.VarChar(20)
  quantity        Int
  reason          String    @db.VarChar(100)
  status          String    @default("Pending Review") @db.VarChar(30)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(255)
  requestDate     DateTime  @default(now()) @map("request_date")
  resolutionDate  DateTime? @map("resolution_date")

  sale    Sale           @relation(fields: [saleId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  user    User           @relation(fields: [userId], references: [identityDocument])

  @@map("sale_returns")
}

// ============================================================================
// 5. GESTIÓN DE CAJAS Y GASTOS
// ============================================================================

/// Cajas físicas y cuentas bancarias/digitales donde ingresa y egresa dinero
model CashRegister {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(100)
  registerType   String  @map("register_type") @db.VarChar(30)
  currentBalance Decimal @default(0.00) @map("current_balance") @db.Decimal(14, 2)
  details        String  @db.VarChar(20)
  status         Boolean @default(true)

  purchases Purchase[]
  payments  Payment[]
  expenses  Expense[]

  @@map("cash_registers")
}

/// Registro de gastos operativos descontados de una caja específica
model Expense {
  id             Int      @id @default(autoincrement())
  concept        String   @db.VarChar(150)
  amount         Decimal  @db.Decimal(14, 2)
  date           DateTime @db.Date
  userId         String   @map("user_id") @db.VarChar(20)
  cashRegisterId Int      @map("cash_register_id")

  user         User         @relation(fields: [userId], references: [identityDocument])
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@map("expenses")
}
